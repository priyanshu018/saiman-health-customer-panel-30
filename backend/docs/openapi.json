{
  "openapi": "3.0.3",
  "info": {
    "title": "Drippify Admin API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/dashboard": {
      "get": {
        "summary": "Dashboard totals and recent activity",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/users": {
      "get": { "summary": "List users", "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/{id}": {
      "get": { "summary": "Get user", "responses": { "200": { "description": "OK" } } },
      "patch": { "summary": "Update user", "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Soft delete user", "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/{id}/block": {
      "patch": { "summary": "Block or unblock user", "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/{id}/verify": {
      "patch": { "summary": "Verify creator profile", "responses": { "200": { "description": "OK" } } }
    },
    "/api/campaigns": {
      "get": { "summary": "List campaigns", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Create campaign", "responses": { "201": { "description": "Created" } } }
    },
    "/api/campaigns/{id}": {
      "get": { "summary": "Get campaign", "responses": { "200": { "description": "OK" } } },
      "patch": { "summary": "Update campaign", "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Soft delete campaign", "responses": { "200": { "description": "OK" } } }
    },
    "/api/bookings": {
      "get": { "summary": "List bookings", "responses": { "200": { "description": "OK" } } }
    },
    "/api/bookings/{id}": {
      "get": { "summary": "Get booking", "responses": { "200": { "description": "OK" } } },
      "patch": { "summary": "Update booking", "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Soft delete booking", "responses": { "200": { "description": "OK" } } }
    },
    "/api/messages/conversations": {
      "get": { "summary": "List conversations", "responses": { "200": { "description": "OK" } } }
    },
    "/api/messages/messages": {
      "get": { "summary": "List messages", "responses": { "200": { "description": "OK" } } }
    },
    "/api/messages/messages/{id}": {
      "get": { "summary": "Get message", "responses": { "200": { "description": "OK" } } }
    },
    "/api/messages/flags": {
      "get": { "summary": "List message flags", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Flag message", "responses": { "201": { "description": "Created" } } }
    },
    "/api/payments": {
      "get": { "summary": "List payments", "responses": { "200": { "description": "OK" } } }
    },
    "/api/payments/{id}": {
      "get": { "summary": "Get payment", "responses": { "200": { "description": "OK" } } },
      "patch": { "summary": "Update payment", "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Soft delete payment", "responses": { "200": { "description": "OK" } } }
    },
    "/api/storage/sign-upload": {
      "post": { "summary": "Create signed upload URL", "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin-logs": {
      "get": { "summary": "List admin logs", "responses": { "200": { "description": "OK" } } }
    },
    "/api/tables/{table}": {
      "get": { "summary": "List table records", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Create table record", "responses": { "201": { "description": "Created" } } }
    },
    "/api/tables/{table}/{id}": {
      "get": { "summary": "Get table record", "responses": { "200": { "description": "OK" } } },
      "patch": { "summary": "Update table record", "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Soft delete table record", "responses": { "200": { "description": "OK" } } }
    }
  }
}
