# Saiman Healthcare — Customer Web Panel
# Copy to .env and fill in real values. Never commit .env.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle — do not
# put secrets there. Unprefixed variables are server-only (Route Handlers).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Route Handlers (payments, admin-style writes) — never
# import this in a "use client" file, and never name it NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (required) ---
# First-party Razorpay integration served from this app's own
# app/api/payments/* Route Handlers, mirroring Saiman-Health-Admin-Panel's
# existing pattern. Server-only — never expose RAZORPAY_KEY_SECRET to the
# client. customer_transactions rows are written via SUPABASE_SERVICE_ROLE_KEY
# server-side, same table the admin panel reads for its transactions view.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Legacy external call-server (no longer used for payments) ---
# Previously brokered Razorpay checkout for this app; payments now go through
# the first-party routes above. Still referenced by mobile and by this app's
# Agora video/voice dependency (not yet migrated — see
# CUSTOMER_WEB_PARITY_AUDIT.md §20.2 and §3 "Video/voice consultation join").
NEXT_PUBLIC_CALL_SERVER_URL=

# --- Video/voice consultation (only if migrating off the call-server for
# Agora; matches Saiman-Health-Admin-Panel's Agora integration) ---
# NEXT_PUBLIC_AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# --- Maps / location (ambulance tracking, address selection) ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# --- Signup OTP (only if porting mobile's OTP flow; see
# Saiman-Customer's EXPO_PUBLIC_SIGNUP_OTP_* for defaults) ---
# NEXT_PUBLIC_SIGNUP_OTP_LENGTH=6
# NEXT_PUBLIC_SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=45
# NEXT_PUBLIC_SIGNUP_OTP_MAX_ATTEMPTS=5
# NEXT_PUBLIC_SIGNUP_OTP_MAX_RESENDS=3
# NEXT_PUBLIC_SIGNUP_OTP_EXPIRY_MINUTES=10

# --- Public site URL (for auth redirects, deep links) ---
# NEXT_PUBLIC_SITE_URL=
